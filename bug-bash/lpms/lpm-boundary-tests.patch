+@file:OptIn(com.stripe.android.paymentelement.CheckoutSessionPreview::class)
+
+package com.stripe.android.checkout
+
+import com.google.common.truth.Truth.assertThat
+import com.stripe.android.paymentsheet.model.CheckoutSessionClientSecret
+import com.stripe.android.paymentsheet.repositories.CheckoutClientPollResponseJsonParser
+import com.stripe.android.paymentsheet.repositories.CheckoutSessionResponseJsonParser
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Test
+import java.io.File
+import java.util.Locale
+
+class LpmBashResponseTest {
+    @Test
+    fun `lpm bash processing sepa keeps summary and complete unpaid status`() {
+        val response = response("outcome-sepa_debit-save-confirm")
+        val session = response.session()
+        assertThat(session.status).isEqualTo(
+            CheckoutElementsController.Session.Status.Complete(CheckoutElementsController.Session.Status.PaymentStatus.Unpaid)
+        )
+        assertSummary(session)
+        val poll = requireNotNull(CheckoutClientPollResponseJsonParser.parse(
+            JSONArray(file("outcome-sepa_debit-save-polls")).getJSONObject(0)
+        ))
+        assertThat(response.withPollResponse(poll).session()).isEqualTo(session)
+    }
+
+    @Test
+    fun `lpm bash redirect pending keeps summary and open status`() {
+        val response = response("outcome-bancontact-confirm")
+        val session = response.session()
+        assertThat(session.status).isInstanceOf(CheckoutElementsController.Session.Status.Open::class.java)
+        assertSummary(session)
+        val poll = requireNotNull(CheckoutClientPollResponseJsonParser.parse(
+            JSONArray(file("outcome-bancontact-polls")).getJSONObject(0)
+        ))
+        assertThat(response.withPollResponse(poll).session()).isEqualTo(session)
+    }
+
+    @Test
+    fun `lpm bash paid card control keeps summary and paid status`() {
+        val session = response("outcome-card-confirm").session()
+        assertThat(session.status).isEqualTo(
+            CheckoutElementsController.Session.Status.Complete(CheckoutElementsController.Session.Status.PaymentStatus.Paid)
+        )
+        assertSummary(session)
+    }
+
+    private fun assertSummary(session: CheckoutElementsController.Session) {
+        assertThat(session.totals.total.minorUnitsAmount).isEqualTo(12000L)
+        assertThat(session.totals.total.amount).isEqualTo("€120.00")
+        val group = session.orderSummaryItems.single() as CheckoutElementsController.Session.OrderSummaryItem.OneTimePrice
+        val item = group.items.single()
+        assertThat(item.displayName).isEqualTo("LPM Test")
+        assertThat(item.quantity).isEqualTo(1)
+        assertThat(item.amountDetails.total.minorUnitsAmount).isEqualTo(12000L)
+    }
+
+    private fun response(name: String) = requireNotNull(
+        CheckoutSessionResponseJsonParser(CheckoutSessionClientSecret("cs_test_lpm_secret_example"))
+            .parse(JSONObject(file(name)))
+    )
+
+    private fun file(name: String): String {
+        val directory = generateSequence(File(".").absoluteFile) { it.parentFile }
+            .map { File(it, "bug-bash/lpms") }.first { it.isDirectory }
+        return File(directory, "$name.json").readText()
+    }
+
+    private fun com.stripe.android.paymentsheet.repositories.CheckoutSessionResponse.session() = asCheckoutSession(
+        collectedEmail = null,
+        collectedShippingName = null,
+        collectedShippingAddress = null,
+        flagImages = null,
+        paymentOption = null,
+        availableExpressButtonTypes = emptyList(),
+        locale = Locale.US,
+    )
+}
