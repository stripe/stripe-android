+    private fun confirmSfuBashJson(name: String): JSONObject {
+        val directory = generateSequence(java.io.File(".").absoluteFile) { it.parentFile }
+            .map { java.io.File(it, "bug-bash/confirm") }.first { it.isDirectory }
+        return JSONObject(java.io.File(directory, "$name.json").readText()).apply {
+            remove("experiments_data")
+            optJSONObject("payment_response")?.optJSONObject("payment_intent")?.let {
+                it.put("id", "pi_confirmbash").put("client_secret", "pi_confirmbash_secret_test")
+            }
+            if (name.endsWith("payment-intent")) {
+                put("id", "pi_confirmbash").put("client_secret", "pi_confirmbash_secret_test")
+            }
+        }
+    }
